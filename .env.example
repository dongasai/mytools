APP_NAME=mytool
APP_TITLE=个人工具
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai
APP_URL=http://127.0.0.1:34007
APP_WEB_INDEX=

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#DB_CONNECTION=sqlite
#DB_TYPE=postgres
#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=laravel
#DB_NAME=name
#DB_USERNAME=root
#DB_USER=root
#DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MINIMAX
MINIMAX_API_KEY

VITE_APP_NAME="${APP_NAME}"

# 短信
SMS_SUPER_CODE_ENABLED=false
SMS_SUPER_CODE=888888
# 测试
# Uniapp 广告 Debug 模式（仅开发环境使用，生产环境必须为 false）
UNIAPP_AD_DEBUG_MODE=false

# 支付宝
ALIPAY_APP_ID=你的应用APPID
ALIPAY_PRIVATE_KEY=你的应用私钥
ALIPAY_PUBLIC_KEY=你的应用公钥
ALIPAY_ALIPAY_PUBLIC_KEY=支付宝公钥（用于验签）

# Account 模块配置
ACCOUNT_AUTH_TOKEN_RATE_LIMIT=10

# Dcat Admin 配置
ADMIN_ROUTE_PREFIX=admin
ADMIN_HTTPS=false

# ApiProto 配置
API_PROTO_INDEX_TOKEN=your_proto_index_token_here
ACCIDENT_API_TOKEN=accident_default_token_change_me

# 旧版系统（greenbid）API 请求器配置
GREENBID_API_BASE_URL=http://eceadmin.greenbid.cn/index.php/api
GREENBID_API_TOKEN=
GREENBID_API_TIMEOUT=10
GREENBID_API_CONNECT_TIMEOUT=5
GREENBID_API_CACHE_ENABLED=true
GREENBID_API_CACHE_TTL=86400

# 工艺数据验证开关
PROCESS_DATA_VALIDATION_ENABLED=false

# 请求日志配置
REQUEST_LOG_ENABLED=true
REQUEST_LOG_MAX_RECORDS=100000


# 日志数据库配置
# 日志专用数据库连接（可选，不配置则使用主数据库）
DB_LOG_HOST=127.0.0.1
DB_LOG_PORT=3306
DB_LOG_DATABASE=tanneng_logs
DB_LOG_USERNAME=root
DB_LOG_PASSWORD=
DB_LOG_CHARSET=utf8mb4
DB_LOG_COLLATION=utf8mb4_unicode_ci
