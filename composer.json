{
    "name": "personal/mytool",
    "type": "project",
    "description": "个人工具集 - 多种实用工具的集合平台",
    "require": {
        "php": "8.4.*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "alibabacloud/oss-v2": "^0.4.0",
        "alipaysdk/easysdk": "*",
        "alipaysdk/openapi": "^3.0",
        "alphasnow/aliyun-oss-laravel": "^4.9",
        "darkaonline/l5-swagger": "^9.0",
        "dcat/easy-excel": "^1.1",
        "dongasai/dcat-admin2": "*",
        "google/protobuf": "^4.0",
        "inhere/php-validate": "^3.0",
        "intervention/image": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9",
        "neuron-core/neuron-ai": "^3.3",
        "nwidart/laravel-modules": "^12.0",
        "overtrue/easy-sms": "^3.2",
        "php-amqplib/php-amqplib": "*",
        "phpoffice/phpspreadsheet": "^2.0",
        "phpseclib/phpseclib": "~3.0",
        "pragmarx/google2fa": "^9.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "symfony/expression-language": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "*",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/",
            "DLaravel\\": "extensions/dlaravel/"
        },
        "classmap": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "cacheclear": "php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear",
        "devcontainer-setup": [
            "[ -f .env ] || cp .env.example .env",
            "php artisan key:generate",
            "php artisan storage:link"
        ],
        "proto":[
            "@buildproto"
        ],
        "buildproto": [
            "php artisan apiproto:gather-proto",
            "php artisan apiproto:generate-proto",
            "php artisan apiproto:fix-namespace",
            "php artisan apiproto:generate-pathlist"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "Modules/*/composer.json"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "joshbrw/laravel-module-installer": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
